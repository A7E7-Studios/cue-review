{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueReview",
  "version": "0.3.0",
  "identifier": "studio.a7e7.cuereview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "CueReview", "width": 1280, "height": 820, "minWidth": 640, "minHeight": 480, "backgroundColor": "#ffffff", "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$LOCALDATA/CueReview/sessions/**"] }
    }
  },
  "bundle": {
    "active": true,
    "macOS": { "entitlements": "Entitlements.plist" },
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Show it. Say it. Fix it.",
    "category": "Productivity"
  }
}
