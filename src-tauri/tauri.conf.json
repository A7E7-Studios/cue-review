{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueReview",
  "version": "0.1.0",
  "identifier": "studio.a7e7.cuereview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "CueReview", "width": 1280, "height": 820, "minWidth": 640, "minHeight": 480, "backgroundColor": "#ffffff" }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$LOCALDATA/CueReview/sessions/**"] }
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "shortDescription": "Show it. Say it. Fix it.", "category": "Productivity" }
}
